# ปิดการเข้าถึงโฟลเดอร์นี้จากเบราว์เซอร์ ยกเว้น daily.php ซึ่งมีรหัส (cron key) ป้องกันอยู่แล้ว
# เดิมปิดทั้งโฟลเดอร์ ทำให้คำสั่ง wget ในคู่มือติดตั้งถูกปฏิเสธ (403) งานอัตโนมัติจึงไม่เคยทำงาน
<IfModule mod_authz_core.c>
  Require all denied
  <Files "daily.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
  <Files "daily.php">
    Order deny,allow
    Allow from all
  </Files>
</IfModule>
