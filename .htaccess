# ============================================================
#  thonglorcarrent (MVC)
#  เขียนให้รองรับทั้ง Apache 2.2 / 2.4 / LiteSpeed
#  ทุก directive ห่อด้วย IfModule เพื่อไม่ให้ host ที่ไม่มีโมดูลนั้นขึ้น error 500
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ---------- Front controller ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # บังคับ HTTPS (เปิดใช้หลังติดตั้ง SSL แล้ว โดยลบ # ออก 2 บรรทัด)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # โฟลเดอร์ภายในและไฟล์ตั้งค่า — ห้ามเปิดผ่านเว็บ (ตอบ 404 ผ่านหน้าระบบ)
  RewriteRule ^(app|config|database|storage|node_modules|assets/css/src)(/|$) - [R=404,L]
  RewriteRule ^(package(-lock)?\.json|tailwind\.config\.js|\.git.*)$ - [R=404,L]

  # ทุกอย่างที่ไม่ใช่ไฟล์/โฟลเดอร์จริง → index.php (ให้ Router ตัดสินใจ)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# ---------- ปิดการเข้าถึงไฟล์ภายในโดยตรง ----------
<FilesMatch "\.(sql|md|log|ini|sh|bak|old)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- แคชไฟล์สแตติก ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# ---------- บีบอัด ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
